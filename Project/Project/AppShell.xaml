<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Project.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
       xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
       xmlns:views="clr-namespace:Project.Views"
       FlyoutWidth="240">

    <Shell.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Sidebar header: app name + logged-in username -->
    <Shell.FlyoutHeader>
        <Grid Padding="20,36,20,20"
              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray900}}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Budget Tracker"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="{Binding CurrentUsername, StringFormat='@{0}'}"
                       FontSize="12"
                       TextColor="#93C5FD" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Main navigation — hidden for admin -->
    <FlyoutItem Title="Dashboard"
                IsVisible="{Binding IsNotAdmin}">
        <ShellContent Route="dashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Transactions"
                IsVisible="{Binding IsNotAdmin}">
        <ShellContent Route="transactions"
                      ContentTemplate="{DataTemplate views:TransactionListPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Categories"
                IsVisible="{Binding IsNotAdmin}">
        <ShellContent Route="categories"
                      ContentTemplate="{DataTemplate views:CategoryView}" />
    </FlyoutItem>

    <FlyoutItem Title="Statistics"
                IsVisible="{Binding IsNotAdmin}">
        <ShellContent Route="statistics"
                      ContentTemplate="{DataTemplate views:StatisticsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile"
                IsVisible="{Binding IsNotAdmin}">
        <ShellContent Route="profile"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

    <!-- Admin-only items — hidden for regular users -->
    <FlyoutItem Title="Admin Overview"
                IsVisible="{Binding IsAdmin}">
        <ShellContent Route="adminDashboard"
                      ContentTemplate="{DataTemplate views:AdminDashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="User Management"
                IsVisible="{Binding IsAdmin}">
        <ShellContent Route="userManagement"
                      ContentTemplate="{DataTemplate views:UserManagementPage}" />
    </FlyoutItem>

    <!-- Sidebar footer: theme toggle + logout -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16,8,16,24">
            <BoxView HeightRequest="1"
                     Margin="0,0,0,8"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

            <!-- Theme toggle -->
            <Border BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0,0,0,8"
                    HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToggleThemeClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Grid WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=LightMode}"
                                     IsVisible="{Binding IsDarkTheme, Converter={StaticResource InvertedBoolConverter}}"
                                     IconSize="18"
                                     IconColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <mi:MauiIcon Icon="{mi:Material Icon=DarkMode}"
                                     IsVisible="{Binding IsDarkTheme}"
                                     IconSize="18"
                                     IconColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </Grid>
                    <Label Text="{Binding ThemeLabel}"
                           VerticalOptions="Center"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                </HorizontalStackLayout>
            </Border>

            <Button Text="Log Out"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource ExpenseColor}"
                    HorizontalOptions="Start"
                    Padding="0" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
