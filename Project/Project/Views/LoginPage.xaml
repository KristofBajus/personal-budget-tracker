<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Project.Views.LoginPage"
             Title="Login">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="400"
                             Padding="20"
                             Spacing="0">

            <Label Text="Budget Tracker"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6" />

            <Label Text="Personal finance made simple"
                   FontSize="13"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   Margin="0,0,0,32" />

            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                    Padding="32">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Welcome back"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Entry Placeholder="Enter your username"
                                   Text="{Binding Username}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Entry Placeholder="Enter your password"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource ExpenseColor}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Fill"
                           IsVisible="{Binding HasError}" />

                    <Button Text="Log In"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            CornerRadius="20"
                            Margin="0,8,0,0" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Don't have an account?"
                               VerticalOptions="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Button Text="Register"
                                Command="{Binding GoToRegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
