<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Project.Views.LoginPage"
             Title="Login">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid>
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="400"
                             Padding="20"
                             Spacing="0">

            <Label Text="Budget Tracker"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6" />

            <Label Text="Personal finance made simple"
                   FontSize="15"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   Margin="0,0,0,32" />

            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                    Padding="32">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Welcome back"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Entry Placeholder="Enter your username"
                                   Text="{Binding Username}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*, auto" ColumnSpacing="4">
                                <Entry Grid.Column="0"
                                       Placeholder="Enter your password"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="Transparent" />
                                <Border Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        StrokeThickness="0"
                                        Padding="4,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <mi:MauiIcon Icon="{mi:Material Icon=Visibility}"
                                                     IsVisible="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                        <mi:MauiIcon Icon="{mi:Material Icon=VisibilityOff}"
                                                     IsVisible="{Binding IsPasswordVisible}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource ExpenseColor}"
                           FontSize="15"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Fill"
                           IsVisible="{Binding HasError}" />

                    <Button Text="Log In"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            CornerRadius="20"
                            Margin="0,8,0,0" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Don't have an account?"
                               VerticalOptions="Center"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Button Text="Register"
                                Command="{Binding GoToRegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    <!-- Theme toggle overlay (top-right corner) -->
    <Border BackgroundColor="Transparent"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Padding="0,35,35,0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnToggleThemeClicked" />
        </Border.GestureRecognizers>
        <Grid WidthRequest="24" HeightRequest="24">
            <mi:MauiIcon x:Name="ThemeLightIcon"
                         Icon="{mi:Material Icon=LightMode}"
                         IconSize="20"
                         IconColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            <mi:MauiIcon x:Name="ThemeDarkIcon"
                         Icon="{mi:Material Icon=DarkMode}"
                         IsVisible="False"
                         IconSize="20"
                         IconColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </Grid>
    </Border>

    <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{StaticResource Primary}" />

    </Grid>

</ContentPage>
