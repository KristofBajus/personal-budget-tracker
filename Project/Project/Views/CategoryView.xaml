<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:Project.Converters"
             x:Class="Project.Views.CategoryView"
             Title="Categories">

    <ContentPage.Resources>
        <converters:HexColorConverter x:Key="HexColor" />
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="auto, *"
          Padding="32,16"
          RowSpacing="12">

        <Button Grid.Row="0"
                Text="+ Add"
                Command="{Binding AddCommand}"
                HorizontalOptions="End" />

        <ScrollView Grid.Row="1">
            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start">

                <!-- Income panel -->
                <Border FlexLayout.Grow="1"
                        FlexLayout.Basis="280"
                        Margin="3,0,3,8"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="0">
                    <VerticalStackLayout>

                        <Label Text="Income"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource IncomeColor}"
                               Margin="14,14,14,10" />

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                 Margin="0,0,0,4" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomeCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="28, *, auto"
                                          ColumnSpacing="10"
                                          Padding="14,10"
                                          MinimumHeightRequest="52">

                                        <BoxView Grid.Column="0"
                                                 WidthRequest="16"
                                                 HeightRequest="16"
                                                 CornerRadius="8"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 BackgroundColor="Transparent"
                                                 Color="{Binding Color, Converter={StaticResource HexColor}}" />

                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               VerticalOptions="Center" />

                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="6"
                                                               VerticalOptions="Center"
                                                               IsVisible="{Binding IsGlobal, Converter={StaticResource InvertBool}}">
                                            <Button Text="Edit"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="14"
                                                    Padding="10,4"
                                                    HeightRequest="30"
                                                    MinimumHeightRequest="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource Primary}"
                                                    BorderWidth="0"
                                                    FontFamily="OpenSansSemibold" />
                                            <Button Text="Delete"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="14"
                                                    Padding="10,4"
                                                    HeightRequest="30"
                                                    MinimumHeightRequest="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource ExpenseColor}"
                                                    BorderWidth="0"
                                                    FontFamily="OpenSansSemibold" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Expense panel -->
                <Border FlexLayout.Grow="1"
                        FlexLayout.Basis="280"
                        Margin="3,0,3,8"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="0">
                    <VerticalStackLayout>

                        <Label Text="Expenses"
                               FontSize="16"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource ExpenseColor}"
                               Margin="14,14,14,10" />

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                 Margin="0,0,0,4" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExpenseCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="28, *, auto"
                                          ColumnSpacing="10"
                                          Padding="14,10"
                                          MinimumHeightRequest="52">

                                        <BoxView Grid.Column="0"
                                                 WidthRequest="16"
                                                 HeightRequest="16"
                                                 CornerRadius="8"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 BackgroundColor="Transparent"
                                                 Color="{Binding Color, Converter={StaticResource HexColor}}" />

                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               VerticalOptions="Center" />

                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="6"
                                                               VerticalOptions="Center"
                                                               IsVisible="{Binding IsGlobal, Converter={StaticResource InvertBool}}">
                                            <Button Text="Edit"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="14"
                                                    Padding="10,4"
                                                    HeightRequest="30"
                                                    MinimumHeightRequest="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource Primary}"
                                                    BorderWidth="0"
                                                    FontFamily="OpenSansSemibold" />
                                            <Button Text="Delete"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="14"
                                                    Padding="10,4"
                                                    HeightRequest="30"
                                                    MinimumHeightRequest="0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource ExpenseColor}"
                                                    BorderWidth="0"
                                                    FontFamily="OpenSansSemibold" />
                                        </HorizontalStackLayout>

                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </FlexLayout>
        </ScrollView>

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

    </Grid>

</ContentPage>
