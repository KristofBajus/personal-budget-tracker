<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:Project.Converters"
             x:Class="Project.Views.CategoryView"
             Title="Categories">

    <ContentPage.Resources>
        <converters:HexColorConverter x:Key="HexColor" />
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="auto, *"
          Padding="16"
          RowSpacing="12">

        <Button Grid.Row="0"
                Text="+ Add"
                Command="{Binding AddCommand}"
                HorizontalOptions="End" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*, *"
              ColumnSpacing="12">

        <!-- Income panel -->
        <Border Grid.Column="0"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                Padding="0">
            <VerticalStackLayout>

                <Label Text="Income"
                       FontSize="14"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource IncomeColor}"
                       Margin="14,12,14,8" />

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                         Margin="0,0,0,4" />

                <CollectionView ItemsSource="{Binding IncomeCategories}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No income categories."
                               FontSize="12"
                               HorizontalOptions="Center"
                               Margin="0,16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="24, *, auto"
                                  ColumnSpacing="8"
                                  Padding="12,6"
                                  MinimumHeightRequest="44">

                                <BoxView Grid.Column="0"
                                         WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Color="{Binding Color, Converter={StaticResource HexColor}}" />

                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       VerticalOptions="Center" />

                                <HorizontalStackLayout Grid.Column="2"
                                                       Spacing="6"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsGlobal, Converter={StaticResource InvertBool}}">
                                    <Button Text="Edit"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            Padding="10,2"
                                            HeightRequest="26"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            BorderWidth="0"
                                            FontFamily="OpenSansSemibold" />
                                    <Button Text="Delete"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            Padding="10,2"
                                            HeightRequest="26"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource ExpenseColor}"
                                            BorderWidth="0"
                                            FontFamily="OpenSansSemibold" />
                                </HorizontalStackLayout>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        <!-- Expense panel -->
        <Border Grid.Column="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                Padding="0">
            <VerticalStackLayout>

                <Label Text="Expenses"
                       FontSize="14"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource ExpenseColor}"
                       Margin="14,12,14,8" />

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                         Margin="0,0,0,4" />

                <CollectionView ItemsSource="{Binding ExpenseCategories}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No expense categories."
                               FontSize="12"
                               HorizontalOptions="Center"
                               Margin="0,16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="24, *, auto"
                                  ColumnSpacing="8"
                                  Padding="12,6"
                                  MinimumHeightRequest="44">

                                <BoxView Grid.Column="0"
                                         WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Color="{Binding Color, Converter={StaticResource HexColor}}" />

                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       VerticalOptions="Center" />

                                <HorizontalStackLayout Grid.Column="2"
                                                       Spacing="6"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsGlobal, Converter={StaticResource InvertBool}}">
                                    <Button Text="Edit"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            Padding="10,2"
                                            HeightRequest="26"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            BorderWidth="0"
                                            FontFamily="OpenSansSemibold" />
                                    <Button Text="Delete"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="13"
                                            Padding="10,2"
                                            HeightRequest="26"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource ExpenseColor}"
                                            BorderWidth="0"
                                            FontFamily="OpenSansSemibold" />
                                </HorizontalStackLayout>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        </Grid>

    </Grid>

</ContentPage>
