<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:Project.Converters"
             x:Class="Project.Views.TransactionListPage"
             Title="Transactions">

    <ContentPage.Resources>
        <converters:HexColorConverter x:Key="HexColor" />
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="auto, *">

        <!-- Filter bar -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                Padding="0,12">
            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Center"
                        Margin="16,0">

                <!-- Search — always full row -->
                <Border FlexLayout.Basis="100%"
                        FlexLayout.Grow="1"
                        Margin="0,4,0,4"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        StrokeThickness="1"
                        Padding="8,2">
                    <Entry Placeholder="Search by category or note"
                           Text="{Binding SearchText}"
                           ClearButtonVisibility="WhileEditing" />
                </Border>

                <!-- Type filter -->
                <Border FlexLayout.Grow="1"
                        Margin="0,4,8,4"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        StrokeThickness="1"
                        Padding="8,2">
                    <Picker Title="All types"
                            ItemsSource="{Binding TypeOptions}"
                            SelectedItem="{Binding FilterTypeName}" />
                </Border>

                <!-- Month filter -->
                <Border FlexLayout.Grow="1"
                        Margin="0,4,8,4"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        StrokeThickness="1"
                        Padding="8,2">
                    <Picker Title="All months"
                            ItemsSource="{Binding MonthOptions}"
                            SelectedItem="{Binding FilterMonthName}" />
                </Border>

                <!-- Year filter -->
                <Border FlexLayout.Grow="1"
                        Margin="0,4,8,4"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        StrokeThickness="1"
                        Padding="8,2">
                    <Picker Title="All years"
                            ItemsSource="{Binding YearOptions}"
                            SelectedItem="{Binding FilterYearName}" />
                </Border>

                <!-- Add button -->
                <Button Margin="0,4,0,4"
                        Text="+ Add"
                        Command="{Binding AddCommand}"
                        WidthRequest="80" />

            </FlexLayout>
        </Border>

        <!-- Transaction list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transactions}"
                        SelectionMode="None"
                        Margin="0,8,0,0">

            <CollectionView.EmptyView>
                <Label Text="No transactions found."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,40"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Padding="16,14"
                            Margin="32,0,32,8">
                        <Grid ColumnDefinitions="36, *, auto" ColumnSpacing="12">

                            <!-- Category colour dot -->
                            <BoxView Grid.Column="0"
                                     WidthRequest="16"
                                     HeightRequest="16"
                                     CornerRadius="8"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     BackgroundColor="Transparent"
                                     Color="{Binding CategoryColor, Converter={StaticResource HexColor}}" />

                            <!-- Category + note + date -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Note}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       IsVisible="{Binding Note, Converter={StaticResource IsStringNotNullOrEmpty}}" />
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                            </VerticalStackLayout>

                            <!-- Amount + actions -->
                            <VerticalStackLayout Grid.Column="2" Spacing="3"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label Text="{Binding FormattedAmount}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource IncomeColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource ExpenseColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                                    <Button Text="Edit"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="14"
                                            FontFamily="OpenSansSemibold"
                                            Padding="10,2"
                                            HeightRequest="30"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary}"
                                            BorderWidth="0" />
                                    <Button Text="Delete"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="14"
                                            FontFamily="OpenSansSemibold"
                                            Padding="10,2"
                                            HeightRequest="30"
                                            MinimumHeightRequest="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource ExpenseColor}"
                                            BorderWidth="0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

    </Grid>

</ContentPage>
