<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Project.Views.RegisterPage"
             Title="Register">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="400"
                             Padding="20"
                             Spacing="0">

            <Label Text="Budget Tracker"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6" />

            <Label Text="Personal finance made simple"
                   FontSize="13"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   Margin="0,0,0,32" />

            <Border StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                    Padding="32">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Create account"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Entry Placeholder="Choose a username"
                                   Text="{Binding Username}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Entry Placeholder="Enter your email"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*, auto" ColumnSpacing="4">
                                <Entry Grid.Column="0"
                                       Placeholder="Min 8 chars, uppercase, number"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="Transparent" />
                                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="4,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <mi:MauiIcon Icon="{mi:Material Icon=Visibility}"
                                                     IsVisible="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                        <mi:MauiIcon Icon="{mi:Material Icon=VisibilityOff}"
                                                     IsVisible="{Binding IsPasswordVisible}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm Password"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                Padding="12,0">
                            <Grid ColumnDefinitions="*, auto" ColumnSpacing="4">
                                <Entry Grid.Column="0"
                                       Placeholder="Repeat your password"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                       BackgroundColor="Transparent" />
                                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" Padding="4,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <mi:MauiIcon Icon="{mi:Material Icon=Visibility}"
                                                     IsVisible="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                        <mi:MauiIcon Icon="{mi:Material Icon=VisibilityOff}"
                                                     IsVisible="{Binding IsPasswordVisible}"
                                                     IconSize="18"
                                                     IconColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Currency"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        <Picker ItemsSource="{Binding Currencies}"
                                SelectedItem="{Binding SelectedCurrency}"
                                Title="Select currency" />
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource ExpenseColor}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="Fill"
                           IsVisible="{Binding HasError}" />

                    <Button Text="Create Account"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,8,0,0" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Already have an account?"
                               VerticalOptions="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Button Text="Log In"
                                Command="{Binding GoToLoginCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
